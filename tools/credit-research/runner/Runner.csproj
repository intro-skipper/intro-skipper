<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CreditCorpusRunner</AssemblyName>
    <!-- Keep this research runner out of the solution build. -->
    <IsPackable>false</IsPackable>
    <!-- This is a throwaway research harness; don't inherit the plugin's strict analyzers. -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <RunAnalyzers>false</RunAnalyzers>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1849;CA1305;CA1812;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../IntroSkipper/IntroSkipper.csproj" />
  </ItemGroup>

</Project>
